---
import Base from "../layouts/Base.astro";
import PromoVideo from "./PromoVideo.astro";
import ProductTour from "./ProductTour.astro";
import PocketShowcase from "./PocketShowcase.astro";
import video from "../data/video.json";
import release from "../data/release.json";
const { lang = "en" } = Astro.props;
const zh = lang === "zh-CN";
const prefix = zh ? "/zh-CN" : "";
const releases = "https://github.com/oratis/LISA/releases/latest";
const store = "https://apps.apple.com/us/app/lisa-pocket/id6784690058";
const motion = "/assets/visuals/soft-ink-motion-v1";
const copy = zh ? {
  title: "个人 AI 助手", description: "LISA 是开源 AI Personal Assistant，帮助你规划、写作、整理知识。登录云端，或连接你自己的 Mac。",
  eyebrow: "AI PERSONAL ASSISTANT · 开源", heading: "把想法变成", accent: "下一步。",
  lede: "和 Lisa 一起规划一天、起草消息、整理值得记住的内容。登录 LISA Cloud 即可开始，也可以在自己的 Mac 上运行，连接你的工具与工作流。",
  cloud: "开始云端对话", mac: "下载 Mac 版", install: "其他安装方式", tags: ["开源", "持久记忆", "自选模型"],
  whatsNew: `v${release.minor} 已发布`, whatsNewLink: "看看更新了什么",
  heroAlt: "Lisa 的 Web 工作区正在规划一天", heroPhoneAlt: "iPhone 上的 Lisa Pocket 房间页",
  starters: "从一件小事开始", prompts: ["帮我安排今天最重要的三件事。", "把这个想法写成一封清晰的邮件。", "整理这些笔记，找出下一步。"],
  companionEyebrow: "陪伴", companionTitle: "十二个表情包，同一个 Lisa。", companionText: "聊天里可以给她发表情包，她也会用心情回应。指针移到表情上看看。", companionLink: "看看她的全部表情",
  stickers: [["hello", "你好"], ["make-a-plan", "做个计划"], ["thinking", "让我想想"], ["well-done", "做得好"], ["tea-break", "喝杯茶"], ["celebrate", "庆祝"]],
  modeEyebrow: "运行方式", modeTitle: "选择适合你的运行方式。",
  modes: [
    ["Mac app", "工作区、菜单栏灵动岛与本地工具", "已签名、公证的应用，内置后端。下载、打开、填入模型密钥即可。", "下载 Mac 版", releases, true],
    ["CLI 与自托管", "你的模型，你的机器", "用 Homebrew 或 npm 安装，使用供应商密钥或本地模型，在本机运行 Web 工作区。", "安装指南", "/zh-CN/install", false],
    ["LISA Cloud", "登录即可聊天", "无需准备 Mac 或模型 API key。账号提供使用额度，可按需购买额外额度。", "了解云端", "/zh-CN/cloud", false],
    ["Lisa Pocket", "iPhone 与 iPad", "云端聊天，或连接你可达的 Mac。连接 Mac 时，它需要开机并可通过网络访问。", "App Store", store, true],
  ],
  boundary: "Cloud 与 Mac 分别保存聊天、记忆和凭据，不会自动同步。使用远程模型时，相关内容会发送给所选供应商。",
  trustEyebrow: "掌控", trustTitle: "Lisa 能看什么、做什么，由你决定。",
  trust: [
    ["数据留在你运行它的地方", "本地安装把身份、记忆和知识以文件形式保存在 ~/.lisa。如果选择远程模型，相关内容会发送给该供应商。"],
    ["没有你的同意，什么都不会自己运行", "聊天里起草的任务默认关闭，需要你启用；连接器只读；交出去的 agent 每一步都等你批准。"],
    ["开源", "MIT 许可。代码、威胁模型和每项功能的边界都在 GitHub 上。"],
  ],
  policy: "隐私政策", source: "在 GitHub 查看源码", caution: "AI 可能出错，请核对重要结果。",
  demo: "观看产品影片", cta: "从今天想完成的一件事开始。",
} : {
  title: "AI Personal Assistant", description: "LISA is an open-source AI Personal Assistant for planning, writing and personal knowledge. Sign in to Cloud or connect your own Mac.",
  eyebrow: "AI PERSONAL ASSISTANT · OPEN SOURCE", heading: "Turn an idea into", accent: "your next step.",
  lede: "Plan your day, draft a message, and keep useful ideas close with Lisa. Start with LISA Cloud, or run Lisa on your Mac and connect your own tools and workflow.",
  cloud: "Start with Cloud", mac: "Download for Mac", install: "More ways to install", tags: ["Open source", "Persistent memory", "Your choice of model"],
  whatsNew: `v${release.minor} is out`, whatsNewLink: "See what's new",
  heroAlt: "The Lisa web workspace planning a day", heroPhoneAlt: "The Room screen of Lisa Pocket on iPhone",
  starters: "Start with something small", prompts: ["Help me plan the three things that matter today.", "Turn this idea into a clear email.", "Organize these notes and suggest a next step."],
  companionEyebrow: "Companion", companionTitle: "Twelve stickers. One Lisa.", companionText: "Send her a sticker in chat and she answers in kind, with a mood of her own. Hover over one to see it move.", companionLink: "Meet all her moods",
  stickers: [["hello", "Hello"], ["make-a-plan", "Make a plan"], ["thinking", "Let me think"], ["well-done", "Well done"], ["tea-break", "Tea break"], ["celebrate", "Celebrate"]],
  modeEyebrow: "Where it runs", modeTitle: "Choose where Lisa works.",
  modes: [
    ["Mac app", "Workspace, menu-bar Island and local tools", "A signed, notarized app with the backend bundled. Download it, open it and add a model key.", "Download for Mac", releases, true],
    ["CLI & self-hosted", "Your model, your machine", "Install with Homebrew or npm and run the web workspace locally, with a provider key or a local model.", "Installation guide", "/install", false],
    ["LISA Cloud", "Sign in and start chatting", "No Mac or model API key needed. An account allowance covers usage, with optional credit packs for more.", "Explore Cloud", "/cloud", false],
    ["Lisa Pocket", "iPhone and iPad", "Cloud chat, or your reachable Mac. To connect to a Mac, it must be running and reachable.", "App Store", store, true],
  ],
  boundary: "Cloud and Mac keep separate conversations, memories and credentials. They do not automatically sync. Remote models receive the relevant content you send them.",
  trustEyebrow: "Control", trustTitle: "You decide what Lisa can see and do.",
  trust: [
    ["Your data, where you run it", "A local install keeps identity, memory and knowledge as files under ~/.lisa. If you choose a remote model, the relevant content is sent to that provider."],
    ["Nothing runs on its own until you say so", "Tasks drafted in chat stay off until you enable them, connectors are read-only, and delegated agents wait for your approval on each step."],
    ["Open source", "MIT licensed. The code, the threat model and the limits of each feature are on GitHub."],
  ],
  policy: "Privacy policy", source: "View the source on GitHub", caution: "AI can make mistakes; check important results.",
  demo: "Watch the film", cta: "Start with one thing you want to get done.",
};
const modeIcons = [
  "M3 5.5A1.5 1.5 0 0 1 4.5 4h15A1.5 1.5 0 0 1 21 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 14.5zM8 20h8M12 16v4",
  "M4.5 4h15A1.5 1.5 0 0 1 21 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5v-13A1.5 1.5 0 0 1 4.5 4zM7 9l3 3-3 3M13 15h4",
  "M7 18a4.5 4.5 0 0 1-.6-8.96A6 6 0 0 1 18 10.5a3.75 3.75 0 0 1-.5 7.5H7z",
  "M9.5 2.5h5A2.5 2.5 0 0 1 17 5v14a2.5 2.5 0 0 1-2.5 2.5h-5A2.5 2.5 0 0 1 7 19V5a2.5 2.5 0 0 1 2.5-2.5zM11 18.5h2",
];
---
<Base title={copy.title} lang={lang} description={copy.description}>
  <section class="hero">
    <div class="hero-copy">
      <a class="pill" href={`${prefix}/changelog`}><b>{copy.whatsNew}</b><span>{copy.whatsNewLink} →</span></a>
      <p class="eyebrow"><span class="rule"></span>{copy.eyebrow}</p>
      <h1>{copy.heading}<br /><span class="accent">{copy.accent}</span></h1>
      <p class="lede">{copy.lede}</p>
      <div class="actions">
        <a class="btn-primary" href="https://cloud.meetlisa.ai">{copy.cloud} →</a>
        <a class="btn-ghost" href={releases}>{copy.mac}</a>
      </div>
      <ul class="tags">{copy.tags.map((tag) => <li>{tag}</li>)}</ul>
    </div>
    <div class="hero-visual">
      <figure class="shot"><img src="/shots/plan.webp" alt={copy.heroAlt} width="1600" height="900" fetchpriority="high" decoding="async" /></figure>
      <figure class="phone hero-phone"><img src="/pocket/room.webp" alt={copy.heroPhoneAlt} width="628" height="1280" decoding="async" /></figure>
    </div>
  </section>

  <section class="starters" aria-labelledby="starters-title">
    <h2 id="starters-title">{copy.starters}</h2>
    <ul>{copy.prompts.map((prompt) => <li>{prompt}</li>)}</ul>
  </section>

  <PromoVideo lang={lang} />
  <ProductTour lang={lang} />

  <section class="section companion" aria-labelledby="companion-title">
    <div>
      <p class="eyebrow"><span class="rule"></span>{copy.companionEyebrow}</p>
      <h2 id="companion-title">{copy.companionTitle}</h2>
      <p class="lede">{copy.companionText}</p>
      <a class="more" href={`${prefix}/moods`}>{copy.companionLink} →</a>
    </div>
    <ul class="stickers">
      {copy.stickers.map(([id, label]) => (
        <li><button type="button" class="sticker" data-sticker data-still={`${motion}/sticker-${id}-static.webp`} data-moving={`${motion}/sticker-${id}.webp`} aria-label={label}>
          <img src={`${motion}/sticker-${id}-static.webp`} alt="" width="160" height="160" loading="lazy" decoding="async" />
          <span aria-hidden="true">{label}</span>
        </button></li>
      ))}
    </ul>
  </section>

  <PocketShowcase lang={lang} />

  <section class="section" aria-labelledby="modes-title">
    <p class="eyebrow"><span class="rule"></span>{copy.modeEyebrow}</p>
    <h2 id="modes-title">{copy.modeTitle}</h2>
    <div class="mode-grid">
      {copy.modes.map(([label, title, text, link, href, external], i) => (
        <article class="card mode">
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d={modeIcons[i]} /></svg>
          <p class="clabel">{label}</p>
          <h3>{title}</h3>
          <p>{text}</p>
          <a href={href as string} target={external ? "_blank" : null} rel={external ? "noopener" : null}>{link} {external ? "↗" : "→"}</a>
        </article>
      ))}
    </div>
    <p class="callout">{copy.boundary}</p>
  </section>

  <section class="section" aria-labelledby="trust-title">
    <p class="eyebrow"><span class="rule"></span>{copy.trustEyebrow}</p>
    <h2 id="trust-title">{copy.trustTitle}</h2>
    <div class="trust-grid">
      {copy.trust.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
    </div>
    <p class="trust-links"><a href={`${prefix}/privacy`}>{copy.policy} →</a><a href="https://github.com/oratis/LISA" target="_blank" rel="noopener">{copy.source} ↗</a><span>{copy.caution}</span></p>
  </section>

  <section class="cta-band">
    <h2>{copy.cta}</h2>
    <div class="actions"><a class="btn-primary" href="https://cloud.meetlisa.ai">{copy.cloud} →</a><a class="btn-ghost" href={`${prefix}/install`}>{copy.install}</a><a class="btn-ghost" href={`https://www.youtube.com/watch?v=${video.youtubeId}`}>{copy.demo} ↗</a></div>
  </section>
</Base>
<script>
  // Stickers rest on a still frame and play while hovered, focused or tapped.
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-sticker]")) {
    const img = button.querySelector("img")!;
    const play = (on: boolean) => { img.src = (on && !still.matches ? button.dataset.moving : button.dataset.still)!; };
    button.addEventListener("pointerenter", () => play(true));
    button.addEventListener("pointerleave", () => play(false));
    button.addEventListener("focus", () => play(true));
    button.addEventListener("blur", () => play(false));
    button.addEventListener("click", () => play(true));
  }
</script>
<style is:global>
  /* Shared product-image frames (hero, tour, Pocket). */
  .shot { margin:0; border:1px solid var(--border-lit); border-radius:16px; overflow:hidden; background:var(--bg-elev); box-shadow:0 30px 70px -32px rgba(0,0,0,.85); }
  .shot img { display:block; width:100%; height:auto; aspect-ratio:16 / 9; }
  .phone { --w:200px; margin:0; padding:calc(var(--w) * .03); border-radius:calc(var(--w) * .15); background:#0b0d10; border:1px solid var(--border-lit); box-shadow:0 26px 50px -24px rgba(0,0,0,.85); }
  .phone img { display:block; width:100%; height:auto; aspect-ratio:628 / 1280; border-radius:calc(var(--w) * .12); }
  :root[data-theme="light"] .shot, :root[data-theme="light"] .phone { box-shadow:0 26px 60px -30px rgba(32,45,70,.35); }
  .lede { font-size:1.08rem; color:var(--muted); line-height:1.7; max-width:62ch; }
  .ticks { list-style:none; padding:0; margin:1.2rem 0 0; display:grid; gap:.6rem; }
  .ticks li { position:relative; padding-left:1.5rem; color:var(--ink); font-size:.97rem; line-height:1.55; }
  .ticks li::before { content:""; position:absolute; left:.15rem; top:.5em; width:.55rem; height:.3rem; border-left:2px solid var(--accent); border-bottom:2px solid var(--accent); transform:rotate(-45deg); }
  @media(max-width:640px) { .lede { font-size:1rem; } }
</style>
<style>
  /* ── Hero: centred copy above one large product shot ── */
  .hero { display:grid; justify-items:center; text-align:center; }
  .hero-copy { max-width:47rem; display:grid; justify-items:center; }
  .hero h1 { font-size:clamp(2.5rem,5.6vw,4.4rem); line-height:1.05; letter-spacing:-.04em; }
  .hero .lede { margin:1.3rem auto 0; }
  .hero .eyebrow { justify-content:center; margin-bottom:1rem; }
  .hero .actions { justify-content:center; margin:1.8rem 0 1.2rem; }
  .pill { display:inline-flex; align-items:center; gap:.7rem; min-height:36px; margin-bottom:1.5rem; padding:.3rem .9rem .3rem .35rem; border:1px solid var(--border-lit); border-radius:999px; background:var(--panel); font-size:.86rem; color:var(--muted); transition:border-color .15s, color .15s; }
  .pill b { padding:.2rem .6rem; border-radius:999px; background:color-mix(in srgb, var(--accent) 16%, transparent); color:var(--accent); font:500 .74rem var(--mono); letter-spacing:.04em; }
  .pill:hover { border-color:var(--accent); color:var(--ink); }
  .tags { list-style:none; padding:0; margin:0; gap:.5rem 1.4rem; justify-content:center; }
  .tags li { display:inline-flex; align-items:center; gap:.5rem; }
  .tags li::before { content:""; width:6px; height:6px; border-radius:50%; background:var(--good); }
  .hero-visual { --pw:clamp(84px,17vw,190px); position:relative; width:100%; margin-top:clamp(2.5rem,5vw,3.6rem); padding:0 calc(var(--pw) * .42) calc(var(--pw) * .2) 0; }
  .hero-phone { --w:var(--pw); position:absolute; right:0; bottom:0; width:var(--pw); }

  /* ── Starters ── */
  .starters { margin-top:clamp(2.5rem,5vw,4rem); }
  .starters h2 { margin:0 0 .8rem; font:500 .72rem var(--mono); letter-spacing:.14em; text-transform:uppercase; color:var(--faint); text-align:center; }
  .starters ul { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.8rem; }
  .starters li { display:flex; align-items:center; padding:.9rem 1.1rem; border:1px solid var(--border); border-radius:14px; background:var(--panel); color:var(--ink); font-size:.95rem; line-height:1.5; }
  .starters li::before { content:"›"; margin-right:.7rem; color:var(--accent); font:600 1.1rem var(--mono); }

  /* ── Companion ── */
  .companion { display:grid; grid-template-columns:minmax(0,5fr) minmax(0,7fr); gap:clamp(1.5rem,4vw,3.5rem); align-items:center; }
  .more { display:inline-flex; align-items:center; min-height:44px; margin-top:.4rem; }
  .stickers { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:.5rem; }
  .sticker { width:100%; display:grid; gap:.3rem; justify-items:center; padding:.7rem .3rem .6rem; border:1px solid var(--border); border-radius:14px; background:var(--panel); color:var(--muted); font:500 .72rem var(--sans); cursor:pointer; transition:transform .18s ease, border-color .18s, background .18s; }
  .sticker img { width:100%; max-width:92px; height:auto; aspect-ratio:1; }
  .sticker:hover, .sticker:focus-visible { transform:translateY(-3px); border-color:var(--border-lit); background:var(--panel-2); color:var(--ink); }

  /* ── Where it runs ── */
  .mode-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1rem; margin-top:1.5rem; }
  .mode { display:flex; flex-direction:column; }
  .mode svg { fill:none; stroke:var(--accent); stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; margin-bottom:1rem; }
  .mode h3 { font-size:1.05rem; }
  .mode p:not(.clabel) { flex:1; }
  .mode a { display:inline-flex; align-items:center; min-height:44px; margin-top:.8rem; }
  .callout { margin:1.4rem 0 0; padding:1rem 1.2rem; border-left:3px solid var(--blue); border-radius:0 12px 12px 0; background:var(--bg-elev); color:var(--muted); font-size:.95rem; line-height:1.65; max-width:none; }

  /* ── Trust ── */
  .trust-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(1.2rem,3vw,2.5rem); margin-top:1.6rem; }
  .trust-grid article { padding-top:1.1rem; border-top:2px solid var(--border-lit); }
  .trust-grid h3 { font-size:1.1rem; }
  .trust-grid p { font-size:.97rem; line-height:1.65; margin-bottom:0; }
  .trust-links { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem 1.6rem; margin:1.6rem 0 0; }
  .trust-links a { display:inline-flex; align-items:center; min-height:44px; }
  .trust-links span { font-family:var(--mono); font-size:.8rem; color:var(--faint); }

  .cta-band { margin-top:clamp(3.5rem,8vw,6rem); }

  @media(max-width:1000px) {
    .mode-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
  @media(max-width:900px) {
    .companion { grid-template-columns:1fr; }
    .starters ul { grid-template-columns:1fr; }
    .trust-grid { grid-template-columns:1fr; }
  }
  @media(max-width:640px) {
    .hero h1 { font-size:clamp(2rem,9.4vw,3rem); line-height:1.1; }
    .hero .actions { margin:1.4rem 0 1rem; width:100%; }
    .pill { margin-bottom:1.1rem; }
    .tags { gap:.4rem 1rem; }
    .starters li { border-radius:12px; padding:.8rem .95rem; }
    .stickers { grid-template-columns:repeat(3,minmax(0,1fr)); }
    .mode-grid { grid-template-columns:1fr; }
    .trust-links { gap:.2rem 1.2rem; }
  }
  @media (hover: none), (prefers-reduced-motion: reduce) { .sticker:hover { transform:none; } }
</style>
