---
import Base from "../layouts/Base.astro";
const { lang = "en" } = Astro.props;
const zh = lang === "zh-CN";
const prefix = zh ? "/zh-CN" : "";
const c = zh ? {
  title: "LISA Cloud", description: "登录 LISA Cloud，使用个人 AI 助手规划、写作和整理知识。无需 Mac 或模型 API key。",
  heading: "你的个人 AI 助手，", accent: "从登录开始。",
  lede: "无需安装后端或准备模型 API key。用 LISA 账号开始对话，规划事务、起草内容，并建立自己的记忆与知识库。",
  start: "打开 LISA Cloud", install: "在 Mac 上运行", note: "登录页提供可用的 Apple、Google 和邮箱选项。已验证邮箱的账号每天可免费使用 $0.30，价格详见下文。",
  compare: "Cloud 与 Mac，各有自己的工作空间。", cols: ["", "你的 Mac", "LISA Cloud"],
  rows: [
    ["开始方式", "安装本地 app，配置自己的模型或托管登录", "登录 LISA 账号"],
    ["聊天、记忆与知识库", "保存在本地 Lisa 实例", "保存在账号对应的云端实例"],
    ["编程 agent、终端与本地集成", "按配置与权限使用", "不提供你 Mac 的本地能力"],
    ["模型", "可选择供应商或本地模型", "标准模型（目前为 Gemini 2.5 Flash）可用免费额度；LISA Cloud 提供的高级模型只使用购买的额度"],
    ["手机访问", "Mac 必须开机并网络可达", "无需连接 Mac"],
    ["跨实例同步", "聊天、记忆与凭据分别保存", "不会自动复制到 Mac"],
    ["费用", "使用自己的模型密钥永久免费，无需账号；模型供应商可能另行收费", "标准模型每天 $0.30 免费额度；可选充值包 $4.99 起"],
  ],
  pricing: "免费开始，按用量付费。",
  pricingItems: [
    "在本地运行 LISA（Mac app、CLI 或自托管 Web）永久免费：使用你自己的模型密钥，无需账号。",
    "LISA Cloud 免费版：每天 $0.30 用量（自首次使用起滚动计算 24 小时），仅限标准模型，目前为 Gemini 2.5 Flash。邮箱未验证的账号每天 $0.10。",
    "已验证邮箱的账号另获一次性 $2.00 欢迎额度（每人一次），同样仅限标准模型。",
    "按 token 计量，价格为模型供应商公开标价的 2 倍。扣费顺序：先用每日免费额度，再用欢迎额度，最后用购买的额度。",
  ],
  packCols: ["充值包", "到账额度", "30 天内每日免费额度"],
  packs: [
    ["$4.99", "$5.00", "$0.60 / 天"],
    ["$9.99", "$10.50", "$0.60 / 天"],
    ["$19.99", "$22.00", "$1.20 / 天"],
  ],
  packNote: "购买的额度永不过期、跟随账号，可用于 LISA Cloud 提供的所有模型，包括高级模型。任意一次购买都会在 30 天内提高每日免费额度。可在 iPhone 上的 Lisa Pocket 中购买，或在网页账号页面购买。",
  control: "账号、额度和数据，由你管理。",
  items: [
    "Cloud 为每个账号隔离助手数据。云端不会获得你 Mac 的文件、终端或邮件权限。",
    "Lisa Pocket 在 AI 聊天前说明接收方和数据用途；取消不会发送草稿，撤回同意后再次发送需要重新授权。",
    "在设置中删除云端账号会移除 Lisa 账号数据并使会话失效。供应商记录、账单留存及 Apple 授权处理见隐私政策。",
    "额外额度是消耗型购买。未使用余额保存在同一 LISA 账号；刷新余额不会恢复已用额度，也不会新建充值。",
  ],
  privacy: "阅读隐私政策", support: "获取支持", pocket: "Lisa Pocket 1.2 已在美区 App Store 上架，支持 iPhone 与 iPad。可用性因地区而异。", pocketDownload: "前往 App Store",
} : {
  title: "LISA Cloud", description: "Sign in to your AI Personal Assistant for planning, writing and personal knowledge. LISA Cloud needs no Mac or model API key.",
  heading: "Your personal AI assistant,", accent: "one sign-in away.",
  lede: "Start a conversation with your LISA account, without installing a backend or bringing a model API key. Plan your work, draft content, and build your own memory and knowledge base.",
  start: "Open LISA Cloud", install: "Run on your Mac", note: "The sign-in page shows available Apple, Google and email options. Verified accounts get $0.30 of free usage every day; pricing is below.",
  compare: "Cloud and Mac, each with its own workspace.", cols: ["", "Your Mac", "LISA Cloud"],
  rows: [
    ["Getting started", "Install locally; configure a model or managed sign-in", "Sign in with a LISA account"],
    ["Chat, memory & knowledge", "Saved within your local Lisa instance", "Saved within your account's cloud instance"],
    ["Coding agents, terminal & integrations", "Available with setup and permissions", "Does not provide your Mac's local capabilities"],
    ["Models", "Choose a provider or local model", "Standard models (today Gemini 2.5 Flash) on the free allowance; any premium model LISA Cloud offers uses purchased credit only"],
    ["Mobile access", "Mac must be running and reachable", "No connection to a Mac required"],
    ["Cross-instance sync", "Conversations, memories and credentials stay separate", "No automatic copying to your Mac"],
    ["Cost", "Free forever with your own model key, no account needed; your provider's charges may apply", "$0.30 a day free on standard models; optional credit packs from $4.99"],
  ],
  pricing: "Start free. Pay only for what you use.",
  pricingItems: [
    "Running LISA locally — the Mac app, CLI or self-hosted web — stays free forever with your own model key. No account needed.",
    "LISA Cloud Free: $0.30 of usage per day (a rolling 24 hours from your first use) on standard models, today Gemini 2.5 Flash. Accounts with an unverified email get $0.10 per day.",
    "Verified accounts also get a one-time $2.00 welcome credit (one per person), for standard models.",
    "Usage is metered per token at 2× the model provider's published list price. Your free daily allowance is used first, then the welcome credit, then purchased credit.",
  ],
  packCols: ["Credit pack", "Credit you get", "Free daily allowance for 30 days"],
  packs: [
    ["$4.99", "$5.00", "$0.60 / day"],
    ["$9.99", "$10.50", "$0.60 / day"],
    ["$19.99", "$22.00", "$1.20 / day"],
  ],
  packNote: "Purchased credit never expires, follows your account, and works on every model LISA Cloud offers, including premium models. Any purchase also raises your free daily allowance for 30 days. Buy credits in Lisa Pocket on iPhone, or from the account page on the web.",
  control: "Manage your account, credit and data.",
  items: [
    "Each Cloud account has isolated assistant data. Cloud does not gain access to your Mac's files, terminal or mail.",
    "Lisa Pocket explains AI recipients and data use before chat. Cancel keeps the draft unsent; withdrawing permission requires consent again before the next send.",
    "Delete your cloud account in Settings to remove Lisa account data and invalidate sessions. The privacy policy explains provider records, billing retention and Apple authorization handling.",
    "Extra credits are consumable purchases. Unused balance belongs to the same LISA account; refreshing it does not restore spending or create another purchase.",
  ],
  privacy: "Read the privacy policy", support: "Get support", pocket: "Lisa Pocket 1.2 is available on the US App Store for iPhone and iPad. Availability varies by region.", pocketDownload: "View on the App Store",
};
---
<Base title={c.title} lang={lang} description={c.description}>
  <header class="page-head">
    <p class="eyebrow"><span class="rule"></span>LISA CLOUD · AI PERSONAL ASSISTANT</p>
    <h1>{c.heading}<br /><span class="accent">{c.accent}</span></h1>
    <p class="lede">{c.lede}</p>
    <div class="actions"><a class="btn-primary" href="https://cloud.meetlisa.ai">{c.start} →</a><a class="btn-ghost" href={`${prefix}/install`}>{c.install}</a></div>
    <p class="note">{c.note}</p>
  </header>
  <section class="section">
    <h2>{c.compare}</h2>
    <div class="comparison">
      <table role="table" aria-label={c.compare}>
        <thead role="rowgroup"><tr role="row">{c.cols.map((col) => <th role="columnheader" scope="col">{col}</th>)}</tr></thead>
        <tbody role="rowgroup">{c.rows.map(([label, mac, cloud]) => <tr role="row"><th role="rowheader" scope="row">{label}</th><td role="cell"><span class="cell-label" aria-hidden="true">{c.cols[1]}</span>{mac}</td><td role="cell"><span class="cell-label" aria-hidden="true">{c.cols[2]}</span>{cloud}</td></tr>)}</tbody>
      </table>
    </div>
  </section>
  <section class="section" id="pricing">
    <h2>{c.pricing}</h2>
    <ul>{c.pricingItems.map((text) => <li>{text}</li>)}</ul>
    <div class="comparison">
      <table class="packs" role="table" aria-label={c.packCols[0]}>
        <thead role="rowgroup"><tr role="row">{c.packCols.map((col) => <th role="columnheader" scope="col">{col}</th>)}</tr></thead>
        <tbody role="rowgroup">{c.packs.map(([price, credit, daily]) => <tr role="row"><th role="rowheader" scope="row"><span class="cell-label" aria-hidden="true">{c.packCols[0]}</span>{price}</th><td role="cell"><span class="cell-label" aria-hidden="true">{c.packCols[1]}</span>{credit}</td><td role="cell"><span class="cell-label" aria-hidden="true">{c.packCols[2]}</span>{daily}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="note">{c.packNote}</p>
  </section>
  <section class="section">
    <h2>{c.control}</h2>
    <ul>{c.items.map((text) => <li>{text}</li>)}</ul>
    <div class="actions"><a href={`${prefix}/privacy`}>{c.privacy} →</a><a href={`${prefix}/support`}>{c.support} →</a></div>
    <p class="note">{c.pocket} <a href="https://apps.apple.com/us/app/lisa-pocket/id6784690058">{c.pocketDownload} →</a></p>
  </section>
</Base>
<style>
  .lede { color:var(--muted); max-width:70ch; line-height:1.7; font-size:1.12rem; }
  h1 { font-size:clamp(2.4rem,5vw,4.3rem); line-height:1.1; }
  .actions { margin:1.5rem 0; }
  .section { margin-top:3.5rem; }
  .comparison { overflow-x:auto; margin-top:1.3rem; }
  table { width:100%; border-collapse:collapse; }
  table.packs { max-width:640px; }
  th,td { border:1px solid var(--border); padding:1rem; text-align:left; vertical-align:top; line-height:1.55; }
  thead { background:var(--panel); }
  td,li { color:var(--muted); }
  ul { max-width:80ch; padding-left:1.3rem; }
  li { margin:1rem 0; line-height:1.7; }
  .cell-label { display:none; }
  @media(max-width:640px) {
    h1 { font-size:clamp(2rem,9vw,3rem); line-height:1.15; }
    .lede { font-size:1rem; }
    .comparison { overflow:visible; }
    table,tbody { display:block; }
    /* Keep table semantics and column headers available to assistive tech. */
    thead { position:absolute; width:1px; height:1px; padding:0; margin:-1px; clip-path:inset(50%); overflow:hidden; white-space:nowrap; }
    tbody { display:grid; gap:.85rem; }
    tbody tr { display:grid; background:var(--panel); border:1px solid var(--border); border-radius:16px; overflow:hidden; }
    th,td { border:0; padding:.85rem 1rem; }
    tbody th { background:var(--bg-elev); font-weight:600; }
    td + td { border-top:1px solid var(--border); }
    .cell-label { display:block; color:var(--accent); font-size:.78rem; font-weight:600; margin-bottom:.3rem; }
  }
</style>
