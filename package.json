{
  "name": "@oratis/lisa",
  "version": "0.27.1",
  "description": "An open-source AI Personal Assistant for planning, writing and personal knowledge, with Cloud and local Mac modes.",
  "keywords": [
    "ai",
    "agent",
    "anthropic",
    "openai",
    "gemini",
    "deepseek",
    "mistral",
    "perplexity",
    "grok",
    "qwen",
    "doubao",
    "moonshot",
    "kimi",
    "glm",
    "hunyuan",
    "minimax",
    "ollama",
    "personal-assistant",
    "pixel-art",
    "mcp"
  ],
  "homepage": "https://meetlisa.ai",
  "bugs": {
    "url": "https://github.com/oratis/LISA/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oratis/LISA.git"
  },
  "license": "MIT",
  "author": "oratis",
  "type": "module",
  "bin": {
    "lisa": "dist/cli.js"
  },
  "files": [
    "dist/",
    "contracts/",
    "channels.example.json",
    "completions/",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/web && rm -rf dist/web/assets && ln -s ../../src/web/assets dist/web/assets",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/cli.js",
    "lisa": "node --enable-source-maps dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "node scripts/format-check.mjs --write",
    "format:check": "node scripts/format-check.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\"",
    "test:coverage": "c8 npm test && node scripts/coverage-thresholds.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate:api-contract": "node scripts/generate-api-contract.mjs",
    "check:api-contract": "node scripts/generate-api-contract.mjs --check",
    "changelog": "node scripts/gen-changelog.mjs",
    "generate-assets": "tsx scripts/generate-pixel-assets.ts",
    "optimize-assets": "tsx scripts/optimize-assets.ts",
    "prepublishOnly": "npm run check:api-contract && npm run typecheck && npm test && npm run build && rm -rf dist/web/assets && cp -R src/web/assets dist/web/assets",
    "postpublish": "npm run copy-assets"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.27.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "imapflow": "^2.0.2",
    "music-metadata": "^11.14.0",
    "openai": "^7.27.0",
    "qrcode-terminal": "^0.12.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/qrcode-terminal": "^0.12.2",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
